# ---------- Public (safe for the browser) ----------
# URL of the deployed FixMate Express API
NEXT_PUBLIC_API_URL=http://localhost:5000
# set to "true" only if you configured Google login below
NEXT_PUBLIC_GOOGLE_ENABLED=false

# ---------- Private (server only) ----------
# Same database + cluster as the Express server
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=fixmate

# BetterAuth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Your site URL (production: https://your-site.vercel.app)
BETTER_AUTH_URL=http://localhost:3000
# extra trusted origins, comma separated (e.g. preview URLs)
TRUSTED_ORIGINS=

# JWT used to talk to the Express server (MUST equal JWT_SECRET in the server .env)
JWT_SECRET=change-me-to-a-long-random-string

# Optional Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
